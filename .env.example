# E-mail Gmail (use uma senha de app; nunca coloque sua senha pessoal)
GMAIL_REMETENTE=
GMAIL_SENHA_APP=

# Destinatarios dos alertas
EMAIL_SEMED=
EMAIL_OUTROS=
EMAIL_ESTOQUE_SEMANAL=

# SNMP da rede (mantenha "public" somente se esse for o valor usado na sua rede)
SNMP_COMMUNITY=public

# Opcionais
# Gere uma chave secreta longa antes de usar em producao.
PAINEL_SESSION_SECRET=
# Rede local permitida em notacao CIDR, por exemplo: 192.168.1.0/24
PAINEL_REDE_LOCAL=
# URL publica do painel, se for usada para links de convite.
PAINEL_BASE_URL=
